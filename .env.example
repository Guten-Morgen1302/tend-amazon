# All optional. Defaults run the full demo locally with no accounts or keys.
TEND_PORT=3100
SIM_PORT=3000
TEND_TZ=Asia/Kolkata
# sim = frozen demo clock starting Fri Oct 16 2026 08:02 plus /admin controls; real = wall clock
TEND_CLOCK=sim
# Required only if you bind to a non-loopback host.
# TEND_TOKEN=change-me
